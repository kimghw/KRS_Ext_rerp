{
  "manifest_version": 3,
  "name": "KR eClass + R&D ERP 현황",
  "version": "0.8.1",
  "description": "eClass 홈 화면에 R&D ERP(rnd.krs.co.kr)의 미승인내역, 과제별 카드미청구 내역(거래별 청구종류·첨부 파일 미리 지정), 과제집행비율(비목별 예산잔액, 예상 비용 계획), 과제 참여율(예비 참여율·기간 계획)과 HR System(hr.krs.co.kr) 급여명세서의 기본연봉·올해 연구수당(직급별 한도·잔여)을 표시하고, ERP 청구서(카드) 화면의 입력(예산·RCMS 기본값, 세목 빠른 선택, 첨부 드래그 앤 드롭, 패널에서 준비한 청구종류·첨부·회의록 참석자 자동 적용, 백그라운드 탭에서 내역 추가·결의서 신청)을 돕고, 과제 화면의 과제책임자/과제명 칸에 내 참여 과제 드롭다운(고르면 팝업 없이 바로 적용)을 넣습니다. 확장 Plus(선택): 이 PC 의 OneNote MCP 서버(KR_MS365_mcp)를 통해 예상 비용을 과제별 원노트 페이지(고른 섹션에 확장이 만듦)와 동기화해 같은 과제 사람들과 공유합니다.",
  "permissions": ["storage", "alarms", "scripting", "declarativeNetRequestWithHostAccess", "offscreen", "clipboardWrite"],
  "host_permissions": ["https://rnd.krs.co.kr/*", "https://eclass.krs.co.kr/*", "https://hr.krs.co.kr/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "R&D ERP 현황",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": [
        "https://eclass.krs.co.kr/eClassVer4/Home/Index*",
        "https://eclass.krs.co.kr/eClassVer4/Home",
        "https://eclass.krs.co.kr/eClassVer4/Home/",
        "https://eclass.krs.co.kr/eClassVer4/",
        "https://eclass.krs.co.kr/eClassVer4"
      ],
      "js": ["lib/format.js", "lib/settings.js", "lib/plan.js", "lib/pay.js", "lib/part.js", "lib/prep.js", "lib/render.js", "content/eclass.js"],
      "css": ["lib/panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://rnd.krs.co.kr/*"],
      "js": ["content/rnd-hook.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://rnd.krs.co.kr/*"],
      "js": ["lib/settings.js", "content/rnd-bridge.js", "content/rnd-claim.js", "content/rnd-prjpick.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://rnd.krs.co.kr/rcomm_0071_01.act*"],
      "js": ["content/rnd-meeting.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://hr.krs.co.kr/*"],
      "js": ["lib/format.js", "lib/settings.js", "lib/hr-api.js", "content/hr-pay.js"],
      "run_at": "document_idle"
    }
  ]
}
